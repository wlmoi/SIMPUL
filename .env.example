# Optional. Keep secrets ONLY on the server; never commit actual keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional ORS pedestrian, wheelchair, car routing and walking isochrones
ORS_API_KEY=
# Optional near-real-time road speed at selected coordinate
TOMTOM_API_KEY=
# Supply a real project contact for the public Nominatim usage policy.
SIMPUL_CONTACT_USER_AGENT=SIMPUL-Research/0.3 (contact: you@example.org)
# Local access only by default. Exposing to LAN requires access controls first.
SIMPUL_HOST=127.0.0.1
PORT=8888
# SIMPUL_DB_PATH=/absolute/path/simpul.sqlite3

# Optional InfluxDB OSS v2 + Grafana. For local Docker setup run:
# python tools/init_monitoring.py (generates .env securely; do not commit).
# INFLUXDB_URL=http://influxdb:8086
# INFLUXDB_ORG=simpul
# INFLUXDB_BUCKET=simpul_observations
# INFLUXDB_TOKEN=GENERATED_LOCALLY
# INFLUXDB_ADMIN_USERNAME=simpul_admin
# INFLUXDB_ADMIN_PASSWORD=GENERATED_LOCALLY
# GRAFANA_ADMIN_PASSWORD=GENERATED_LOCALLY

# Optional passive PUBLIC news context only; install server/requirements-openosint.txt first.
# Do NOT set OPENOSINT_ALLOW_ACTIVE for SIMPUL.
SIMPUL_PUBLIC_OSINT_ENABLED=0

# v1.3 local API hardening (optional for localhost, REQUIRED for any explicitly allowed non-local host).
# Generate an unpredictable token locally; DO NOT commit or paste real secrets into docs.
# SIMPUL_API_TOKEN=
# SIMPUL_ALLOWED_HOSTS=example.test  # only permit trusted hostnames behind HTTPS
# SIMPUL_HOST remains loopback for default local usage; Docker publishes only 127.0.0.1 ports.
